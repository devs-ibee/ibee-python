# Hand-written files. `fern generate` must not overwrite them; everything else under
# src/ibee is generated from platform-docs fern/openapi/ibee-cloud.yaml (0.4.0) with
# fernapi/fern-python-sdk 5.15.2 and this generator config:
#   client: {class_name: BaseIbee, filename: base_client.py, exported_class_name: Ibee, exported_filename: client.py}
#   package_name: ibee
# and this spec override (the SDK fills both values when a call leaves them out):
#   components.parameters.WorkspaceId.required: false
#   components.parameters.IdempotencyKey.required: false
.fernignore
.github/
.gitignore
CHANGELOG.md
LICENSE
README.md
pyproject.toml
tests/
src/ibee/client.py
src/ibee/core/api_error.py
src/ibee/transport.py
src/ibee/held.py
